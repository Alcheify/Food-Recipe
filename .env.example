# Copy this file to `.env` and paste the values from
# Firebase Console -> Project settings -> Your apps -> Web app -> SDK setup and configuration.
# While these are empty, the app runs in local demo mode with data stored in your browser.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# "firestore" stores compressed photos in Firestore and works on the free Spark plan.
# Use "storage" only if your project is upgraded to Blaze and Storage is enabled.
VITE_IMAGE_MODE=firestore
